@model Whistleblowing.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Whistleblowing System</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#f5f7ff] text-slate-900 antialiased">
    <div class="pointer-events-none fixed -left-32 -top-32 h-96 w-96 rounded-full bg-blue-300/30 blur-3xl"></div>
    <div class="pointer-events-none fixed -bottom-40 -right-24 h-[30rem] w-[30rem] rounded-full bg-violet-300/30 blur-3xl"></div>
    <main class="relative flex min-h-screen items-center justify-center p-4 sm:p-8">
        <section class="w-full max-w-lg rounded-[2rem] border border-white/80 bg-white/80 p-7 shadow-[0_30px_100px_-35px_rgba(37,55,110,0.3)] backdrop-blur-xl sm:p-10">
            <a asp-action="Login" class="mb-9 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-blue-700">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6M9 12h12"/></svg>
                Back to sign in
            </a>
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-lg shadow-blue-600/25">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6.75h16A1.25 1.25 0 0 1 21.25 8v8A1.25 1.25 0 0 1 20 17.25H4A1.25 1.25 0 0 1 2.75 16V8A1.25 1.25 0 0 1 4 6.75Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m3.5 7.5 8.5 6 8.5-6m-8.5 6v5"/></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">Account recovery</p>
            <h1 class="text-3xl font-semibold tracking-tight">Forgot your password?</h1>
            <p class="mt-3 text-sm leading-6 text-slate-500">Enter the email address linked to your account. If it matches an active account, we’ll send a secure password reset link.</p>

            <form asp-action="ForgotPassword" method="post" class="mt-8 space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                <div>
                    <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="name@company.com" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <button type="submit" class="w-full rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20">Send reset link</button>
            </form>
            <p class="mt-7 text-center text-xs leading-5 text-slate-400">For your security, this page does not reveal whether an email address has an account.</p>
        </section>
    </main>
</body>
</html>
