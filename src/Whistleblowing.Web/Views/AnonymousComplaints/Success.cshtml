@{
    ViewData["Title"] = "Complaint Submitted";
    var code = ViewData["ReferenceCode"] as string ?? "";
}

<div class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-lg">
        <div class="rounded-2xl border border-white/60 bg-white/70 p-8 shadow-xl shadow-blue-900/5 backdrop-blur-xl">
            <div class="text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                    <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h1 class="mt-5 text-xl font-bold text-gray-900">Complaint Submitted Successfully</h1>
                <p class="mt-2 text-sm text-gray-600">Your anonymous complaint has been received. Save your reference code below to track it later.</p>
            </div>

            @if (!string.IsNullOrEmpty(code))
            {
                <div class="mt-6 rounded-xl border-2 border-blue-300 bg-blue-50/70 p-4">
                    <div class="text-center">
                        <p class="text-xs font-medium uppercase tracking-wide text-blue-700">Your Reference Code</p>
                        <p id="refCode" class="mt-2 font-mono text-2xl font-bold tracking-wider text-blue-900">@code</p>
                    </div>
                    <div class="mt-4 grid grid-cols-2 gap-2">
                        <button type="button" onclick="copyCode()" class="inline-flex items-center justify-center gap-2 rounded-md border border-blue-300 bg-white px-3 py-2 text-xs font-medium text-blue-700 hover:bg-blue-100 transition">
                            <svg id="copyIcon" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" /></svg>
                            <span id="copyText">Copy Code</span>
                        </button>
                        <a href="/AnonymousComplaints/Track?code=@code" class="inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-3 py-2 text-xs font-medium text-white hover:bg-blue-700 transition">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                            Track Complaint
                        </a>
                    </div>
                </div>
            }

            <div class="mt-6 rounded-md border border-amber-200 bg-amber-50/70 p-3">
                <p class="text-xs text-amber-800"><strong>Important:</strong> Save this code! It's your only way to check your complaint status or add additional information later. We cannot recover it if you lose it.</p>
            </div>

            <a href="/Account/Login" class="mt-6 flex items-center justify-center gap-2 rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
                Back to Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCode() {
            const code = document.getElementById('refCode').innerText;
            navigator.clipboard.writeText(code).then(() => {
                document.getElementById('copyText').innerText = 'Copied!';
                setTimeout(() => { document.getElementById('copyText').innerText = 'Copy Code'; }, 2000);
            });
        }
    </script>
}
