@using Whistleblowing.Application.DTOs
@using Whistleblowing.Domain.Enums
@model ConvertComplaintDto
@{
    ViewData["Title"] = "Convert to Case";
}

<div class="mx-auto max-w-2xl space-y-6">
    <a asp-controller="Complaints" asp-action="Detail" asp-route-id="@Model.ComplaintId"
       class="group inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 transition hover:text-blue-600">
        <svg class="h-3.5 w-3.5 transition group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Complaint
    </a>

    <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg shadow-blue-500/30">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Create Case from Complaint</h1>
            <p class="mt-0.5 text-sm text-gray-600">Review the complaint and set the case priority.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @TempData["Error"]
        </div>
    }

    <div class="rounded-2xl border border-white/60 bg-white/60 p-6 shadow-lg backdrop-blur-xl">
        <h2 class="text-sm font-semibold text-gray-700">Complaint Summary</h2>
        <div class="mt-3 space-y-3">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-gray-500">Title</div>
                <div class="mt-1 text-base font-semibold text-gray-900">@Model.ComplaintTitle</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.ComplaintCategory))
            {
                <div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-gray-500">Category</div>
                    <div class="mt-1"><span class="inline-flex rounded-md bg-white/70 px-2 py-0.5 text-xs font-medium">@Model.ComplaintCategory</span></div>
                </div>
            }
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-gray-500">Description</div>
                <p class="mt-1 whitespace-pre-wrap text-sm leading-relaxed text-gray-800">@Model.ComplaintDescription</p>
            </div>
            @if (Model.ComplaintIsAnonymous)
            {
                <div class="rounded-xl border border-blue-200 bg-blue-50 p-3 text-xs text-blue-800">
                    <strong>Anonymous complaint</strong> — the reporter's identity will not be linked to this case.
                </div>
            }
        </div>
    </div>

    <div class="rounded-2xl border border-white/60 bg-white/60 p-6 shadow-lg backdrop-blur-xl">
        <form asp-action="Convert" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ComplaintId" />
            <input type="hidden" asp-for="ComplaintTitle" />
            <input type="hidden" asp-for="ComplaintDescription" />
            <input type="hidden" asp-for="ComplaintCategory" />
            <input type="hidden" asp-for="ComplaintIsAnonymous" />

            <div>
                <label asp-for="Priority" class="mb-2 block text-sm font-semibold text-gray-800">Case Priority</label>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                    @foreach (var p in Enum.GetValues<CasePriority>())
                    {
                        <label class="cursor-pointer">
                            <input type="radio" asp-for="Priority" value="@p" class="peer sr-only" />
                            <div class="rounded-xl border-2 border-gray-200 bg-white/60 p-3 text-center transition peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-lg">
                                <div class="text-sm font-semibold text-gray-900">@p</div>
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="Priority" class="text-xs text-red-600"></span>
            </div>

            <div class="flex justify-end gap-3 border-t border-white/60 pt-5">
                <a asp-controller="Complaints" asp-action="Detail" asp-route-id="@Model.ComplaintId"
                   class="rounded-xl border border-white/60 bg-white/60 px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-white">
                    Cancel
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-500/30 transition hover:from-emerald-700 hover:to-teal-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    Create Case
                </button>
            </div>
        </form>
    </div>
</div>