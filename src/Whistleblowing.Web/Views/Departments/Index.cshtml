@model IReadOnlyList<Whistleblowing.Domain.Entities.Department>
@{ ViewData["Title"] = "Departments"; }
<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div><h1 class="text-2xl font-bold text-gray-900">Departments</h1><p class="mt-1 text-sm text-gray-600">Manage organization departments and their managers.</p></div>
        <a asp-action="Create" class="rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg">Add department</a>
    </div>
    @if (TempData["Success"] is string message) { <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@message</div> }
    <div class="overflow-hidden rounded-2xl border border-white/60 bg-white/70 shadow-xl shadow-blue-900/5">
        <div class="overflow-x-auto"><table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-white/70 text-left text-xs uppercase tracking-wide text-gray-500"><tr><th class="px-5 py-3">Department</th><th class="px-5 py-3">Manager</th><th class="px-5 py-3">Members</th><th class="px-5 py-3 text-right">Actions</th></tr></thead>
            <tbody class="divide-y divide-gray-100">
            @foreach (var department in Model)
            {
                <tr><td class="px-5 py-4"><div class="font-semibold text-gray-900">@department.Name</div><div class="mt-1 max-w-xl text-gray-500">@(string.IsNullOrWhiteSpace(department.Description) ? "No description" : department.Description)</div></td><td class="px-5 py-4 text-gray-700">@(department.Manager?.FullName ?? "Unassigned")</td><td class="px-5 py-4 text-gray-700">@department.Users.Count</td><td class="px-5 py-4"><div class="flex justify-end gap-3"><a asp-action="Edit" asp-route-id="@department.Id" class="font-medium text-blue-700 hover:text-blue-900">Edit</a><form asp-action="Delete" asp-route-id="@department.Id" method="post" onsubmit="return confirm('Delete this department? Its users will become unassigned.');">@Html.AntiForgeryToken()<button class="font-medium text-red-600 hover:text-red-800" type="submit">Delete</button></form></div></td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="px-5 py-10 text-center text-gray-500">No departments yet. Add one to organize users.</td></tr> }
            </tbody>
        </table></div>
    </div>
</div>
