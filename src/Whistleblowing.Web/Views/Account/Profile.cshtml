@model Whistleblowing.Domain.Entities.ApplicationUser
@using Whistleblowing.Web.Models.Account
@{
    ViewData["Title"] = "My Profile";
    var profile = ViewBag.Profile as EditProfileViewModel ?? new EditProfileViewModel { FullName = Model.FullName, Phone = Model.Phone };
}
<div class="space-y-6">
    @if (TempData["ProfileSuccess"] is string profileSuccess) { <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@profileSuccess</div> }
    @if (TempData["PasswordSuccess"] is string passwordSuccess) { <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@passwordSuccess</div> }
    <div><h1 class="text-2xl font-bold text-gray-900">My Profile</h1><p class="mt-1 text-sm text-gray-600">Update your contact details and password.</p></div>
    <div class="grid gap-4 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/60 bg-white/70 p-6 shadow-xl shadow-blue-900/5 backdrop-blur-xl">
            <div class="flex flex-col items-center text-center"><div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-2xl font-bold text-white shadow-lg">@(Model.FullName.Length > 0 ? Model.FullName[..1].ToUpperInvariant() : "?")</div><h2 class="mt-4 text-lg font-bold text-gray-900">@Model.FullName</h2><p class="mt-1 break-all text-sm text-gray-600">@Model.Email</p><span class="mt-3 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">@Model.Status</span></div>
        </div>
        <div class="lg:col-span-2 rounded-2xl border border-white/60 bg-white/70 p-6 shadow-xl shadow-blue-900/5 backdrop-blur-xl">
            <h2 class="text-base font-semibold text-gray-900">Account details</h2>
            <form asp-action="UpdateProfile" method="post" class="mt-4 space-y-4">
                @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-sm text-rose-600"></div>
                <div><label for="FullName" class="mb-1 block text-sm font-medium text-gray-700">Full name</label><input id="FullName" name="FullName" value="@profile.FullName" maxlength="150" required class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" /><span class="text-xs text-rose-600">@Html.ValidationMessage("FullName")</span></div>
                <div><label for="Email" class="mb-1 block text-sm font-medium text-gray-700">Email</label><input id="Email" value="@Model.Email" readonly class="w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-500" /><p class="mt-1 text-xs text-gray-400">Contact an administrator to change your email.</p></div>
                <div><label for="Phone" class="mb-1 block text-sm font-medium text-gray-700">Phone</label><input id="Phone" name="Phone" value="@profile.Phone" maxlength="20" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" /><span class="text-xs text-rose-600">@Html.ValidationMessage("Phone")</span></div>
                <div class="flex justify-end border-t border-gray-100 pt-4"><button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700">Save profile</button></div>
            </form>
        </div>
    </div>
    <div class="rounded-2xl border border-white/60 bg-white/70 p-6 shadow-xl shadow-blue-900/5 backdrop-blur-xl">
        <h2 class="text-base font-semibold text-gray-900">Change password</h2><p class="mt-1 text-sm text-gray-500">Enter your current password to choose a new one.</p>
        <form asp-action="ChangePassword" method="post" class="mt-4 grid gap-4 sm:grid-cols-3">
            @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="sm:col-span-3 text-sm text-rose-600"></div>
            <div><label for="CurrentPassword" class="mb-1 block text-sm font-medium text-gray-700">Current password</label><input id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm" /><span class="text-xs text-rose-600">@Html.ValidationMessage("Password")</span></div>
            <div><label for="NewPassword" class="mb-1 block text-sm font-medium text-gray-700">New password</label><input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm" /><span class="text-xs text-rose-600">@Html.ValidationMessage("NewPassword")</span></div>
            <div><label for="ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700">Confirm new password</label><input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm" /><span class="text-xs text-rose-600">@Html.ValidationMessage("ConfirmPassword")</span></div>
            <div class="sm:col-span-3 flex justify-end"><button type="submit" class="rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50">Update password</button></div>
        </form>
    </div>
</div>
