@using Whistleblowing.Application.DTOs
@using Whistleblowing.Domain.Enums
@model IReadOnlyList<CaseListItemDto>
@{
    ViewData["Title"] = ViewBag.PageTitle as string ?? "Cases";
    var isInvestigator = (bool)(ViewBag.IsInvestigator ?? false);
    string StatusBadge(CaseStatus status) => status switch
    {
        CaseStatus.Open => "bg-sky-100 text-sky-800 border-sky-200",
        CaseStatus.Investigating => "bg-violet-100 text-violet-800 border-violet-200",
        CaseStatus.PendingReview => "bg-amber-100 text-amber-800 border-amber-200",
        CaseStatus.Closed => "bg-emerald-100 text-emerald-800 border-emerald-200",
        CaseStatus.Archived => "bg-slate-100 text-slate-700 border-slate-200",
        _ => "bg-gray-100 text-gray-800 border-gray-200",
    };
    string PriorityBadge(CasePriority p) => p switch
    {
        CasePriority.Low => "bg-slate-100 text-slate-700 border-slate-200",
        CasePriority.Medium => "bg-blue-100 text-blue-700 border-blue-200",
        CasePriority.High => "bg-amber-100 text-amber-700 border-amber-200",
        CasePriority.Critical => "bg-red-100 text-red-700 border-red-200",
        _ => "bg-gray-100 text-gray-700 border-gray-200",
    };
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg shadow-blue-500/30">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">@ViewBag.PageTitle</h1>
                <p class="mt-0.5 text-sm text-gray-600">@ViewBag.PageSubtitle</p>
            </div>
        </div>

        <div class="inline-flex items-center gap-2 rounded-xl border border-white/60 bg-white/60 px-3.5 py-2 shadow-lg backdrop-blur-xl">
            <span class="text-sm font-semibold text-gray-900">@Model.Count case@(Model.Count == 1 ? "" : "s")</span>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-3xl border-2 border-dashed border-gray-300 bg-white/60 p-12 text-center backdrop-blur-sm">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
            </div>
            <p class="mt-3 text-sm font-semibold text-gray-900">
                @(isInvestigator ? "No cases assigned yet" : "No cases yet")
            </p>
            <p class="mt-1 text-xs text-gray-500">
                @(isInvestigator
                    ? "Your manager will assign cases to you."
                    : "Cases will appear here when managers convert concerns.")
            </p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var c in Model)
            {
                <a asp-action="Detail" asp-route-id="@c.Id" class="group block rounded-2xl border border-white/60 bg-white/60 p-4 shadow-lg backdrop-blur-xl transition hover:-translate-y-0.5 hover:shadow-xl">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h3 class="truncate text-base font-semibold text-gray-900 group-hover:text-blue-700">@c.ComplaintTitle</h3>
                                @if (c.ComplaintIsAnonymous)
                                {
                                    <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-medium text-gray-600">Anonymous</span>
                                }
                            </div>
                            <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs">
                                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 font-medium @StatusBadge(c.Status)">@c.Status</span>
                                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 font-medium @PriorityBadge(c.Priority)">@c.Priority</span>
                                @if (!string.IsNullOrEmpty(c.ComplaintCategory))
                                {
                                    <span class="text-gray-500">· @c.ComplaintCategory</span>
                                }
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-3 text-xs text-gray-500">
                                @if (!string.IsNullOrEmpty(c.AssignedInvestigatorName))
                                {
                                    <span>Investigator: <span class="font-medium text-gray-700">@c.AssignedInvestigatorName</span></span>
                                }
                                else
                                {
                                    <span class="italic text-amber-600">Unassigned</span>
                                }
                                <span>Case #@c.Id.ToString().Substring(0, 8)</span>
                            </div>
                        </div>
                        <div class="text-xs text-gray-400 whitespace-nowrap">
                            @((c.UpdatedAt ?? c.CreatedAt).ToString("MMM dd"))
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>