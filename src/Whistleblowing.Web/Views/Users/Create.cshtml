@using Whistleblowing.Application.DTOs
@model CreateUserDto
@{
    ViewData["Title"] = "New User";
}

<div class="mx-auto max-w-2xl space-y-6">
    <!-- Back link -->
    <a asp-action="Index" class="group inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 transition hover:text-blue-600">
        <svg class="h-3.5 w-3.5 transition group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Users
    </a>

    <!-- Header -->
    <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg shadow-blue-500/30">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Create New User</h1>
            <p class="mt-0.5 text-sm text-gray-600">Add a new user to the system with a specific role.</p>
        </div>
    </div>

    <!-- Form card -->
    <div class="rounded-2xl border border-white/60 bg-white/60 p-6 shadow-lg backdrop-blur-xl">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>

            <div>
                <label asp-for="FullName" class="mb-1.5 block text-sm font-semibold text-gray-800">Full Name</label>
                <input asp-for="FullName" type="text"
                       class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"
                       placeholder="John Doe" />
                <span asp-validation-for="FullName" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Email" class="mb-1.5 block text-sm font-semibold text-gray-800">Email</label>
                <input asp-for="Email" type="email"
                       class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"
                       placeholder="user@wb.local" />
                <span asp-validation-for="Email" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Phone" class="mb-1.5 block text-sm font-semibold text-gray-800">
                    Phone <span class="font-normal text-gray-400">(optional)</span>
                </label>
                <input asp-for="Phone" type="tel"
                       class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"
                       placeholder="+94 71 234 5678" />
                <span asp-validation-for="Phone" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="mb-1.5 block text-sm font-semibold text-gray-800">Password</label>
                <input asp-for="Password" type="password" autocomplete="new-password"
                       class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"
                       placeholder="Min 8 chars (upper + lower + digit + symbol)" />
                <span asp-validation-for="Password" class="text-xs text-red-600"></span>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="RoleName" class="mb-1.5 block text-sm font-semibold text-gray-800">Role</label>
                    <select asp-for="RoleName" asp-items="ViewBag.Roles"
                            class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10">
                        <option value="">— Select role —</option>
                    </select>
                    <span asp-validation-for="RoleName" class="text-xs text-red-600"></span>
                </div>

                <div>
                    <label asp-for="DepartmentId" class="mb-1.5 block text-sm font-semibold text-gray-800">
                        Department <span class="font-normal text-gray-400">(optional)</span>
                    </label>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments"
                            class="w-full rounded-xl border border-gray-200 bg-white/70 px-3.5 py-3 text-sm transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10">
                        <option value="">— No department —</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-xs text-red-600"></span>
                </div>
            </div>

            <div class="flex justify-end gap-3 border-t border-white/60 pt-5">
                <a asp-action="Index"
                   class="rounded-xl border border-white/60 bg-white/60 px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-white">
                    Cancel
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>