@{
    var stats = ViewBag.Stats as Whistleblowing.Application.Interfaces.AdminStatsDto;
    ViewData["Title"] = "Admin Dashboard";
}

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Good morning, @ViewBag.FullName 👋</h1>
            <p class="mt-1 text-sm text-gray-600">System overview and administration.</p>
        </div>
        <a asp-controller="Users" asp-action="Index"
           class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
            Manage Users
        </a>
    </div>

    <!-- Stat cards -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-gradient-to-br from-sky-400 to-sky-500 p-4 text-white shadow-lg shadow-sky-500/25">
            <div class="text-sm font-medium text-white/95">Total Users</div>
            <div class="mt-2 text-2xl font-bold">@(stats?.TotalUsers ?? 0)</div>
            <div class="mt-3 rounded-lg bg-white/20 px-3 py-2 text-xs flex justify-between"><span>All accounts</span><span class="font-semibold">@(stats?.TotalUsers ?? 0)</span></div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-500 p-4 text-white shadow-lg shadow-emerald-500/25">
            <div class="text-sm font-medium text-white/95">Active Users</div>
            <div class="mt-2 text-2xl font-bold">@(stats?.ActiveUsers ?? 0)</div>
            <div class="mt-3 rounded-lg bg-white/20 px-3 py-2 text-xs flex justify-between"><span>Currently active</span><span class="font-semibold">@(stats?.ActiveUsers ?? 0)</span></div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-orange-400 to-orange-500 p-4 text-white shadow-lg shadow-orange-500/25">
            <div class="text-sm font-medium text-white/95">Suspended</div>
            <div class="mt-2 text-2xl font-bold">@(stats?.SuspendedUsers ?? 0)</div>
            <div class="mt-3 rounded-lg bg-white/20 px-3 py-2 text-xs flex justify-between"><span>Inactive or suspended</span><span class="font-semibold">@(stats?.SuspendedUsers ?? 0)</span></div>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-violet-400 to-violet-500 p-4 text-white shadow-lg shadow-violet-500/25">
            <div class="text-sm font-medium text-white/95">Departments</div>
            <div class="mt-2 text-2xl font-bold">@(stats?.TotalDepartments ?? 0)</div>
            <div class="mt-3 rounded-lg bg-white/20 px-3 py-2 text-xs flex justify-between"><span>Organization units</span><span class="font-semibold">@(stats?.TotalDepartments ?? 0)</span></div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid gap-4 sm:grid-cols-3">
        <a asp-controller="Users" asp-action="Index"
           class="group flex items-start gap-3 rounded-2xl border border-white/60 bg-white/60 p-4 shadow-lg backdrop-blur-xl transition hover:-translate-y-0.5 hover:shadow-xl">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-blue-700">User Management</h3>
                <p class="mt-0.5 text-xs text-gray-500">Manage accounts, roles, status</p>
            </div>
        </a>
        <a asp-controller="Complaints" asp-action="Index"
           class="group flex items-start gap-3 rounded-2xl border border-white/60 bg-white/60 p-4 shadow-lg backdrop-blur-xl transition hover:-translate-y-0.5 hover:shadow-xl">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-violet-700">All Concerns</h3>
                <p class="mt-0.5 text-xs text-gray-500">Review and convert to cases</p>
            </div>
        </a>
        <a asp-controller="Cases" asp-action="Index"
           class="group flex items-start gap-3 rounded-2xl border border-white/60 bg-white/60 p-4 shadow-lg backdrop-blur-xl transition hover:-translate-y-0.5 hover:shadow-xl">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-emerald-700">All Cases</h3>
                <p class="mt-0.5 text-xs text-gray-500">Assign and monitor investigations</p>
            </div>
        </a>
    </div>
</div>
