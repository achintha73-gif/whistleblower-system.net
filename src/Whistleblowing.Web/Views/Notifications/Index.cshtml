@using Whistleblowing.Application.DTOs
@model IReadOnlyList<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="mx-auto max-w-3xl space-y-6">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg shadow-blue-500/30">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Notifications</h1>
                <p class="mt-0.5 text-sm text-gray-600">
                    @(unreadCount > 0 ? $"You have {unreadCount} unread notification{(unreadCount == 1 ? "" : "s")}." : "You are all caught up.")
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="inline-flex items-center gap-2 rounded-xl border border-white/60 bg-white/60 px-3.5 py-2 shadow-lg backdrop-blur-xl"><span class="text-sm font-semibold text-gray-900">@Model.Count total</span></div>
            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button type="submit" class="rounded-lg px-3 py-2 text-xs font-semibold text-blue-700 transition hover:bg-blue-50">Mark all read</button></form>
            }
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-3xl border-2 border-dashed border-gray-300 bg-white/60 p-12 text-center backdrop-blur-sm">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
            </div>
            <p class="mt-3 text-sm font-semibold text-gray-900">No notifications</p>
            <p class="mt-1 text-xs text-gray-500">You will see updates here when events happen.</p>
        </div>
    }
    else
    {
        <ul class="space-y-2">
            @foreach (var n in Model)
            {
                <li class="group relative flex items-start gap-3 overflow-hidden rounded-2xl border p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg @(n.IsRead ? "border-white/60 bg-white/60 backdrop-blur-xl" : "border-blue-200/60 bg-gradient-to-br from-blue-50/90 to-indigo-50/90 backdrop-blur-xl shadow-blue-500/10")">
                    @if (!n.IsRead)
                    {
                        <span class="absolute left-0 top-1/2 h-8 w-1 -translate-y-1/2 rounded-r-full bg-gradient-to-b from-blue-500 to-indigo-600"></span>
                    }

                    <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white/70 backdrop-blur-sm">
                        <svg class="h-4 w-4 @(n.IsRead ? "text-gray-400" : "text-blue-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                    </div>

                    <div class="min-w-0 flex-1">
                        <p class="text-sm leading-relaxed @(n.IsRead ? "text-gray-700" : "font-medium text-gray-900")">@n.Message</p>
                        <p class="mt-1.5 text-xs text-gray-500">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>

                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" method="post" class="shrink-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-md shadow-blue-500/25 transition hover:from-blue-700 hover:to-indigo-700">
                                Mark read
                            </button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>
