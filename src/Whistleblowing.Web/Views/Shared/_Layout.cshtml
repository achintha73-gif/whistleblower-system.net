@using Microsoft.EntityFrameworkCore
@using Whistleblowing.Infrastructure.Data
@inject AppDbContext SettingsContext
@{
    var organizationName = await SettingsContext.SystemSettings.AsNoTracking()
        .Where(setting => setting.Key == ApplicationSettingKeys.OrganizationName)
        .Select(setting => setting.Value)
        .FirstOrDefaultAsync() ?? "Whistleblowing System";
    var bodyClasses = User.Identity?.IsAuthenticated == true
        ? "flex h-dvh flex-col overflow-hidden bg-gradient-to-br from-blue-100 via-purple-100 to-gray-100"
        : "min-h-screen bg-gradient-to-br from-blue-100 via-purple-100 to-gray-100";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @organizationName</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClasses">
    <div class="pointer-events-none fixed -top-40 -right-40 h-96 w-96 rounded-full bg-purple-300/30 blur-3xl"></div>
    <div class="pointer-events-none fixed -bottom-40 -left-40 h-96 w-96 rounded-full bg-blue-300/30 blur-3xl"></div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Top header -->
        <header class="sticky top-0 z-30 border-b border-white/60 bg-white/40 backdrop-blur-xl">
            <div class="flex items-center justify-between gap-2 px-3 py-2.5 sm:px-6 sm:py-3">
                <div class="flex min-w-0 items-center gap-2 sm:gap-2.5">
                    <button type="button" data-mobile-menu-button aria-controls="mobile-sidebar" aria-expanded="false" aria-label="Open navigation menu"
                            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/70 bg-white/70 text-slate-700 shadow-sm transition hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 lg:hidden">
                        <svg data-menu-open-icon class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                        <svg data-menu-close-icon class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 6 12 12M18 6 6 18" /></svg>
                    </button>
                    <a asp-controller="Dashboard" asp-action="Index" class="flex min-w-0 items-center gap-2 sm:gap-2.5">
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 shadow-md shadow-blue-500/30">
                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <span class="max-w-[calc(100vw-190px)] truncate text-sm font-semibold text-gray-900 sm:max-w-none sm:text-lg">@organizationName</span>
                    </a>
                </div>

                <div class="flex shrink-0 items-center gap-2 sm:gap-3">
                    <a asp-controller="Notifications" asp-action="Index"
                       class="relative inline-flex items-center justify-center rounded-xl border border-white/60 bg-white/60 p-2 text-gray-600 backdrop-blur-sm transition hover:bg-white hover:text-gray-900">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                        @await Component.InvokeAsync("NotificationBadge")
                    </a>
                    <a asp-controller="Account" asp-action="Profile" title="Profile" aria-label="Profile"
                       class="inline-flex h-9 items-center justify-center gap-2 rounded-xl border border-white/60 bg-white/60 px-2.5 text-sm font-medium text-gray-700 shadow-sm backdrop-blur-sm transition hover:bg-white hover:text-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 sm:px-3">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        <span class="hidden max-w-32 truncate sm:inline">@User.Identity?.Name</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Logout" aria-label="Logout"
                                class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-rose-100 bg-white/60 text-slate-600 shadow-sm backdrop-blur-sm transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 8.25V5.5A1.5 1.5 0 0014.25 4h-8.5a1.5 1.5 0 00-1.5 1.5v13A1.5 1.5 0 005.75 20h8.5a1.5 1.5 0 001.5-1.5v-2.75M10 12h10m0 0-3.5-3.5M20 12l-3.5 3.5" /></svg>
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <button type="button" data-sidebar-overlay aria-label="Close navigation menu" class="fixed inset-0 z-40 hidden bg-slate-950/55 opacity-0 transition-opacity lg:hidden"></button>

        <!-- Body: sidebar + main -->
        <div class="relative flex min-h-0 flex-1 overflow-hidden">
            @await Html.PartialAsync("_Sidebar")
            <main class="min-h-0 min-w-0 flex-1 overflow-x-hidden overflow-y-auto overscroll-contain p-3 sm:p-4 lg:p-5">
                <div class="mx-auto w-full min-w-0 max-w-7xl">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <main class="relative z-10">@RenderBody()</main>
    }

    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (() => {
                const menuButton = document.querySelector('[data-mobile-menu-button]');
                const sidebar = document.querySelector('[data-mobile-sidebar]');
                const overlay = document.querySelector('[data-sidebar-overlay]');
                if (!menuButton || !sidebar || !overlay) return;

                const openMenu = () => {
                    sidebar.classList.remove('-translate-x-full');
                    sidebar.classList.add('translate-x-0');
                    overlay.classList.remove('hidden');
                    requestAnimationFrame(() => overlay.classList.remove('opacity-0'));
                    menuButton.setAttribute('aria-expanded', 'true');
                    menuButton.setAttribute('aria-label', 'Close navigation menu');
                    menuButton.querySelector('[data-menu-open-icon]')?.classList.add('hidden');
                    menuButton.querySelector('[data-menu-close-icon]')?.classList.remove('hidden');
                };
                const closeMenu = () => {
                    sidebar.classList.add('-translate-x-full');
                    sidebar.classList.remove('translate-x-0');
                    overlay.classList.add('opacity-0');
                    window.setTimeout(() => {
                        if (menuButton.getAttribute('aria-expanded') !== 'true') overlay.classList.add('hidden');
                    }, 180);
                    menuButton.setAttribute('aria-expanded', 'false');
                    menuButton.setAttribute('aria-label', 'Open navigation menu');
                    menuButton.querySelector('[data-menu-open-icon]')?.classList.remove('hidden');
                    menuButton.querySelector('[data-menu-close-icon]')?.classList.add('hidden');
                };

                menuButton.addEventListener('click', () => menuButton.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu());
                overlay.addEventListener('click', closeMenu);
                sidebar.querySelector('[data-mobile-menu-close]')?.addEventListener('click', closeMenu);
                sidebar.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
                document.addEventListener('keydown', event => { if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') closeMenu(); });
                window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
            })();
        </script>
    }
</body>
</html>
