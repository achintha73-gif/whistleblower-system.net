@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
        <h1 class="text-2xl font-bold text-gray-900">Good morning, @ViewBag.FullName 👋</h1>
        <p class="mt-1 text-sm text-gray-600">Review concerns and manage cases.</p>
    </div>
        <a asp-controller="Users" asp-action="Index"
           class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
            View Team
        </a>
    </div>

    <div class="rounded-2xl border border-white/60 bg-white/60 p-8 text-center shadow-lg backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-gray-900">Manager Dashboard</h2>
        <p class="mt-2 text-sm text-gray-600">Feature is under construction.</p>
    </div>
</div>