@using Whistleblowing.Application.DTOs
@using Whistleblowing.Domain.Enums
@model IReadOnlyList<ComplaintDto>
@{
    ViewData["Title"] = "Employee Dashboard";
    var recentNotifications = ViewBag.RecentNotifications as IReadOnlyList<NotificationDto> ?? Array.Empty<NotificationDto>();
    var total = (int)(ViewBag.TotalConcerns ?? 0);
    var pending = (int)(ViewBag.PendingCount ?? 0);
    var underReview = (int)(ViewBag.UnderReviewCount ?? 0);
    var decided = (int)(ViewBag.DecidedCount ?? 0);
    var approved = (int)(ViewBag.ApprovedCount ?? 0);
    var rejected = (int)(ViewBag.RejectedCount ?? 0);
    var converted = (int)(ViewBag.ConvertedCount ?? 0);
    var unread = (int)(ViewBag.UnreadNotificationCount ?? 0);

    string StatusStyle(ComplaintStatus status) => status switch
    {
        ComplaintStatus.Pending => "border-amber-200 bg-amber-50 text-amber-800",
        ComplaintStatus.UnderReview => "border-blue-200 bg-blue-50 text-blue-800",
        ComplaintStatus.Approved => "border-emerald-200 bg-emerald-50 text-emerald-800",
        ComplaintStatus.Rejected => "border-rose-200 bg-rose-50 text-rose-800",
        ComplaintStatus.ConvertedToCase => "border-violet-200 bg-violet-50 text-violet-800",
        _ => "border-gray-200 bg-gray-50 text-gray-700"
    };

    string StatusLabel(ComplaintStatus status) => status switch
    {
        ComplaintStatus.Pending => "Pending",
        ComplaintStatus.UnderReview => "Under review",
        ComplaintStatus.Approved => "Approved",
        ComplaintStatus.Rejected => "Not approved",
        ComplaintStatus.ConvertedToCase => "In investigation",
        _ => status.ToString()
    };
}

<div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Good morning, @ViewBag.FullName 👋</h1>
                <p class="mt-1 text-sm text-gray-600">Track your concerns and follow their progress.</p>
                @if (unread > 0)
                {
                    <a asp-controller="Notifications" asp-action="Index" class="mt-2 inline-flex items-center gap-2 text-xs font-semibold text-blue-700 hover:text-blue-900">
                        <span class="h-2 w-2 rounded-full bg-blue-600"></span>@unread unread notification@(unread == 1 ? "" : "s")
                    </a>
                }
            </div>
            <div class="flex flex-wrap gap-3">
                <a asp-controller="Complaints" asp-action="Create" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Submit a concern
                </a>
                <a asp-controller="Account" asp-action="Profile" class="inline-flex items-center gap-2 rounded-xl border border-white/60 bg-white/60 px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm backdrop-blur transition hover:bg-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    My profile
                </a>
            </div>
    </div>

    <section aria-label="Concern summary" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <a asp-controller="Complaints" asp-action="Index" class="group relative overflow-hidden rounded-2xl border border-white/20 bg-gradient-to-br from-sky-400 to-sky-500 p-4 text-white shadow-lg shadow-sky-500/25 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-center justify-between"><span class="text-sm font-medium text-white/90">All my concerns</span><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg></span></div>
            <div class="mt-3 text-2xl font-bold tracking-tight text-white">@total</div><div class="mt-3 flex justify-between rounded-lg bg-white/20 px-3 py-2 text-xs"><span>Submitted from your account</span><span class="font-semibold">@total</span></div>
        </a>
        <a asp-controller="Complaints" asp-action="Index" class="group relative overflow-hidden rounded-2xl border border-white/20 bg-gradient-to-br from-emerald-400 to-emerald-500 p-4 text-white shadow-lg shadow-emerald-500/25 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-center justify-between"><span class="text-sm font-medium text-white/90">Awaiting review</span><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span></div>
            <div class="mt-3 text-2xl font-bold tracking-tight text-white">@pending</div><div class="mt-3 flex justify-between rounded-lg bg-white/20 px-3 py-2 text-xs"><span>Pending initial review</span><span class="font-semibold">@pending</span></div>
        </a>
        <a asp-controller="Complaints" asp-action="Index" class="group relative overflow-hidden rounded-2xl border border-white/20 bg-gradient-to-br from-orange-400 to-orange-500 p-4 text-white shadow-lg shadow-orange-500/25 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-center justify-between"><span class="text-sm font-medium text-white/90">Under review</span><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 12s3.5-6.75 9.75-6.75S21.75 12 21.75 12 18.25 18.75 12 18.75 2.25 12 2.25 12z" /><circle cx="12" cy="12" r="2.5" stroke-width="1.8" /></svg></span></div>
            <div class="mt-3 text-2xl font-bold tracking-tight text-white">@underReview</div><div class="mt-3 flex justify-between rounded-lg bg-white/20 px-3 py-2 text-xs"><span>Being assessed</span><span class="font-semibold">@underReview</span></div>
        </a>
        <a asp-controller="Complaints" asp-action="Index" class="group relative overflow-hidden rounded-2xl border border-white/20 bg-gradient-to-br from-violet-400 to-violet-500 p-4 text-white shadow-lg shadow-violet-500/25 transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-center justify-between"><span class="text-sm font-medium text-white/90">In investigation</span><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20 text-white ring-1 ring-white/25"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span></div>
            <div class="mt-3 text-2xl font-bold tracking-tight text-white">@converted</div><div class="mt-3 flex justify-between rounded-lg bg-white/20 px-3 py-2 text-xs"><span>Converted to cases</span><span class="font-semibold">@converted</span></div>
        </a>
    </section>

    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.6fr)_minmax(280px,0.8fr)]">
        <section class="overflow-hidden rounded-2xl border border-white/70 bg-white/70 shadow-lg shadow-gray-900/5 backdrop-blur-xl">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100/80 px-4 py-3 sm:px-6">
                <div><h2 class="font-semibold text-gray-900">Recent concerns</h2><p class="mt-1 text-xs text-gray-500">Your latest submissions and their current status</p></div>
                <a asp-controller="Complaints" asp-action="Index" class="rounded-lg px-3 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-50">View all</a>
            </div>
            @if (Model.Count == 0)
            {
                <div class="px-6 py-8 text-center">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg></div>
                    <h3 class="mt-3 text-sm font-semibold text-gray-900">No concerns submitted yet</h3>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-gray-500">When you submit a concern, you can follow its progress here.</p>
                    <a asp-controller="Complaints" asp-action="Create" class="mt-5 inline-flex items-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-blue-600/20 transition hover:bg-blue-700">Submit your first concern</a>
                </div>
            }
            else
            {
                <div class="divide-y divide-gray-100/80">
                    @foreach (var item in Model)
                    {
                        <a asp-controller="Complaints" asp-action="Detail" asp-route-id="@item.Id" class="group flex flex-col gap-3 px-4 py-3 transition hover:bg-white/70 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                            <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h3 class="truncate text-sm font-semibold text-gray-900 transition group-hover:text-blue-700">@item.Title</h3>@if (item.IsAnonymous) { <span class="rounded-full border border-gray-200 bg-gray-50 px-2 py-0.5 text-[10px] font-medium text-gray-600">Anonymous</span> }</div>
                                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500"><span>@(string.IsNullOrWhiteSpace(item.Category) ? "General" : item.Category)</span><span>Submitted @item.CreatedAt.ToString("MMM dd, yyyy")</span></div>
                            </div>
                            <span class="inline-flex w-fit shrink-0 items-center rounded-full border px-2.5 py-1 text-xs font-semibold @StatusStyle(item.Status)">@StatusLabel(item.Status)</span>
                        </a>
                    }
                </div>
            }
        </section>

        <div class="space-y-4">
            <section class="rounded-2xl border border-white/70 bg-white/70 p-4 shadow-lg shadow-gray-900/5 backdrop-blur-xl">
                <div class="flex items-start justify-between gap-3"><div><h2 class="font-semibold text-gray-900">Concern outcomes</h2><p class="mt-1 text-xs text-gray-500">Decisions and investigations</p></div><span class="rounded-lg bg-gray-50 px-2.5 py-1 text-xs font-semibold text-gray-600">@decided decided</span></div>
                <div class="mt-5 space-y-4">
                    <div><div class="mb-1.5 flex justify-between text-xs"><span class="font-medium text-gray-600">Approved</span><span class="font-semibold text-gray-800">@approved</span></div><div class="h-2 overflow-hidden rounded-full bg-gray-100"><div class="h-full rounded-full bg-emerald-500" style="width: @(total == 0 ? 0 : (int)Math.Round((double)approved / total * 100))%"></div></div></div>
                    <div><div class="mb-1.5 flex justify-between text-xs"><span class="font-medium text-gray-600">Not approved</span><span class="font-semibold text-gray-800">@rejected</span></div><div class="h-2 overflow-hidden rounded-full bg-gray-100"><div class="h-full rounded-full bg-rose-400" style="width: @(total == 0 ? 0 : (int)Math.Round((double)rejected / total * 100))%"></div></div></div>
                    <div><div class="mb-1.5 flex justify-between text-xs"><span class="font-medium text-gray-600">In investigation</span><span class="font-semibold text-gray-800">@converted</span></div><div class="h-2 overflow-hidden rounded-full bg-gray-100"><div class="h-full rounded-full bg-violet-500" style="width: @(total == 0 ? 0 : (int)Math.Round((double)converted / total * 100))%"></div></div></div>
                </div>
            </section>

            <section class="rounded-2xl border border-white/70 bg-white/70 shadow-lg shadow-gray-900/5 backdrop-blur-xl">
                <div class="flex items-center justify-between border-b border-gray-100/80 px-4 py-3"><div><h2 class="font-semibold text-gray-900">Latest notifications</h2><p class="mt-1 text-xs text-gray-500">Updates about your account</p></div><a asp-controller="Notifications" asp-action="Index" class="text-xs font-semibold text-blue-700 hover:text-blue-900">View all</a></div>
                @if (recentNotifications.Count == 0)
                {
                    <p class="px-4 py-6 text-center text-sm text-gray-500">You are all caught up. Updates will appear here.</p>
                }
                else
                {
                    <ul class="divide-y divide-gray-100/80">
                        @foreach (var notification in recentNotifications)
                        {
                            <li class="flex gap-3 px-4 py-3"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full @(notification.IsRead ? "bg-gray-300" : "bg-blue-600")"></span><div class="min-w-0"><p class="text-sm leading-5 @(notification.IsRead ? "text-gray-600" : "font-medium text-gray-900")">@notification.Message</p><p class="mt-1 text-xs text-gray-400">@notification.CreatedAt.ToString("MMM dd, yyyy · HH:mm")</p></div></li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</div>
