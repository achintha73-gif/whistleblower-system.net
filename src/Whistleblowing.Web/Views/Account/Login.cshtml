@model Whistleblowing.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
    var anonymousMode = string.Equals(ViewBag.LoginMode as string, "anonymous", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Whistleblowing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <style>
        @@keyframes login-float {
            0%, 100% { transform: translate3d(0, 0, 0); }
            50% { transform: translate3d(0, -14px, 0); }
        }
        @@keyframes login-enter {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes mode-panel-in {
            from { opacity: 0; transform: translateY(8px) scale(.99); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @@keyframes mode-panel-out {
            from { opacity: 1; transform: translateY(0) scale(1); }
            to { opacity: 0; transform: translateY(-5px) scale(.995); }
        }
        @@view-transition { navigation: auto; }
        ::view-transition-group(login-mode-tabs),
        ::view-transition-group(login-mode-panel) { animation-duration: 280ms; animation-timing-function: cubic-bezier(.22, 1, .36, 1); }
        ::view-transition-old(login-mode-panel) { animation: mode-panel-out 150ms ease-in both; }
        ::view-transition-new(login-mode-panel) { animation: mode-panel-in 280ms cubic-bezier(.22, 1, .36, 1) both; }
        .login-orb { animation: login-float 12s ease-in-out infinite; }
        .login-content { animation: login-enter .55s ease-out both; }
        @@media (prefers-reduced-motion: reduce) {
            .login-orb, .login-content { animation: none; }
            ::view-transition-group(login-mode-tabs),
            ::view-transition-group(login-mode-panel) { animation-duration: 1ms; }
        }
    </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <main class="relative flex min-h-screen items-center justify-center overflow-hidden p-3 sm:p-5 lg:p-7">
        <div class="login-orb pointer-events-none fixed -right-28 -top-36 h-96 w-96 rounded-full bg-pink-200/55 blur-3xl"></div>
        <div class="login-orb pointer-events-none fixed -bottom-44 -left-36 h-[30rem] w-[30rem] rounded-full bg-blue-200/45 blur-3xl" style="animation-delay:-6s"></div>

        <div class="relative grid min-h-[min(760px,calc(100vh-2rem))] w-full max-w-[1240px] overflow-hidden rounded-[2rem] border border-white/80 bg-white shadow-[0_24px_80px_-35px_rgba(31,41,75,0.35)] md:grid-cols-[0.98fr_1.02fr]">
            <aside class="relative m-3 hidden overflow-hidden rounded-[1.65rem] bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-700 p-9 text-white shadow-inner shadow-white/10 sm:p-10 md:flex md:flex-col md:justify-between lg:p-11">
                <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border border-white/10"></div>
                <div class="pointer-events-none absolute -right-12 -top-12 h-56 w-56 rounded-full border border-white/10"></div>
                <div class="pointer-events-none absolute -bottom-24 -left-20 h-72 w-72 rounded-full bg-fuchsia-400/20 blur-3xl"></div>

                <div class="relative z-10 flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/20 bg-white/15 shadow-lg shadow-indigo-950/15">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3 4.5 6v5.2c0 4.7 3.2 8.7 7.5 9.8 4.3-1.1 7.5-5.1 7.5-9.8V6L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m9 12 2 2 4-4"/></svg>
                    </span>
                    <span>
                        <span class="block text-sm font-bold tracking-tight">Whistleblowing</span>
                        <span class="mt-0.5 block text-[10px] text-blue-100">Management System</span>
                    </span>
                </div>

                <div class="login-content relative z-10 my-10 max-w-md">
                    <h2 class="text-4xl font-bold leading-[1.12] tracking-tight lg:text-[42px]">Report with confidence.<br /><span class="mt-1 inline-block text-blue-100">Stay anonymous.</span></h2>
                    <p class="mt-5 max-w-sm text-sm leading-6 text-blue-100">A secure platform to report workplace concerns — with full anonymity, tracking, and role-based investigation.</p>

                    <div class="relative mx-auto mt-8 flex h-40 max-w-[300px] items-center justify-center rounded-2xl border border-white/20 bg-white/10 shadow-inner shadow-white/5">
                        <div class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/15"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V7a5 5 0 0 1 10 0v3m-11.25 0h12.5A1.75 1.75 0 0 1 20 11.75v7.5A1.75 1.75 0 0 1 18.25 21h-12.5A1.75 1.75 0 0 1 4 19.25v-7.5A1.75 1.75 0 0 1 5.75 10Z"/></svg></div>
                        <div class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/15"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h8m-8 4h8m-8 4h5M5 3.75h14A1.25 1.25 0 0 1 20.25 5v14A1.25 1.25 0 0 1 19 20.25H5A1.25 1.25 0 0 1 3.75 19V5A1.25 1.25 0 0 1 5 3.75Z"/></svg></div>
                        <div class="absolute bottom-4 left-4 flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/15"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 12s3.5-6 9.75-6 9.75 6 9.75 6-3.5 6-9.75 6-9.75-6-9.75-6Z"/><circle cx="12" cy="12" r="2.75" stroke-width="1.8"/></svg></div>
                        <div class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/15"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h8m-8 4h8m-8 4h5M5 3.75h14A1.25 1.25 0 0 1 20.25 5v14A1.25 1.25 0 0 1 19 20.25H5A1.25 1.25 0 0 1 3.75 19V5A1.25 1.25 0 0 1 5 3.75Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m9 15 2 2 4-4"/></svg></div>
                        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-violet-300/40 shadow-lg shadow-indigo-950/10"><svg class="h-11 w-11" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3 4.5 6v5.2c0 4.7 3.2 8.7 7.5 9.8 4.3-1.1 7.5-5.1 7.5-9.8V6L12 3Z"/></svg></div>
                    </div>

                    <ul class="mt-6 space-y-3 text-xs font-medium text-blue-50">
                        <li class="flex items-center gap-2.5"><span class="flex h-6 w-6 items-center justify-center rounded-lg border border-white/20 bg-white/10">✓</span> End-to-end secure authentication</li>
                        <li class="flex items-center gap-2.5"><span class="flex h-6 w-6 items-center justify-center rounded-lg border border-white/20 bg-white/10">✓</span> Anonymous reporting with tracking codes</li>
                        <li class="flex items-center gap-2.5"><span class="flex h-6 w-6 items-center justify-center rounded-lg border border-white/20 bg-white/10">✓</span> Evidence uploads and investigation reports</li>
                        <li class="flex items-center gap-2.5"><span class="flex h-6 w-6 items-center justify-center rounded-lg border border-white/20 bg-white/10">✓</span> Role-based access for all users</li>
                    </ul>
                </div>

                <p class="relative z-10 text-[10px] text-blue-100/75">&copy; @DateTime.Now.Year Whistleblowing Management System</p>
            </aside>

            <section class="flex min-w-0 items-center justify-center px-6 py-10 sm:px-10 md:px-8 lg:px-12 xl:px-16">
                <div class="login-content w-full max-w-[430px]">
                    <div class="mb-7 flex items-center justify-center gap-2.5 md:hidden">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-md shadow-blue-600/25"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3 4.5 6v5.2c0 4.7 3.2 8.7 7.5 9.8 4.3-1.1 7.5-5.1 7.5-9.8V6L12 3Z"/></svg></span>
                        <span class="font-bold text-blue-700">Whistleblowing</span>
                    </div>

                    <div class="mb-6 text-center">
                        <span class="mb-2 inline-flex items-center gap-1.5 rounded-full border border-blue-100 bg-blue-50/80 px-2.5 py-1 text-[9px] font-semibold uppercase tracking-[0.16em] text-blue-700"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Secure reporting portal</span>
                        <h1 class="text-3xl font-bold tracking-tight text-slate-950">Welcome Back</h1>
                        <p class="mt-1 text-sm text-slate-500">Please login to your account</p>
                    </div>

                    <div class="mb-5 grid grid-cols-2 rounded-xl border border-slate-200/90 bg-slate-100/80 p-1 shadow-inner shadow-slate-900/[0.025]" style="view-transition-name:login-mode-tabs">
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="flex items-center justify-center gap-2 rounded-md px-3 py-2 text-xs font-medium transition duration-200 @(anonymousMode ? "text-slate-600 hover:bg-white" : "bg-white text-blue-700 shadow-sm ring-1 ring-slate-200/80")" aria-current="@(anonymousMode ? null : "page")" style="view-transition-name:login-tab-employee">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 19v-1.5a4.5 4.5 0 0 0-4.5-4.5h-1A4.5 4.5 0 0 0 6 17.5V19m9-11a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>
                            Employee
                        </a>
                        <a asp-controller="Account" asp-action="Login" asp-route-mode="anonymous" class="flex items-center justify-center gap-2 rounded-md px-3 py-2 text-xs font-medium transition duration-200 @(anonymousMode ? "bg-white text-blue-700 shadow-sm ring-1 ring-slate-200/80" : "text-slate-600 hover:bg-white")" aria-current="@(anonymousMode ? "page" : null)" style="view-transition-name:login-tab-anonymous">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V7a5 5 0 0 1 10 0v3m-11.25 0h12.5A1.75 1.75 0 0 1 20 11.75v7.5A1.75 1.75 0 0 1 18.25 21h-12.5A1.75 1.75 0 0 1 4 19.25v-7.5A1.75 1.75 0 0 1 5.75 10Z"/></svg>
                            Anonymous
                        </a>
                    </div>

                    <div style="view-transition-name:login-mode-panel">
                    @if (anonymousMode)
                    {
                        <div class="rounded-2xl border border-blue-200 bg-blue-50/70 p-4">
                            <div class="flex items-start gap-3">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-700"><svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3 4.5 6v5.2c0 4.7 3.2 8.7 7.5 9.8 4.3-1.1 7.5-5.1 7.5-9.8V6L12 3Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m9 12 2 2 4-4"/></svg></span>
                                <div>
                                    <h2 class="text-sm font-semibold text-blue-900">Submit Anonymously</h2>
                                    <p class="mt-1 text-[11px] leading-4 text-blue-800">Your identity will be completely hidden. No login required. You will receive a reference code to track your concern.</p>
                                </div>
                            </div>
                        </div>

                        <ul class="my-5 space-y-2.5 text-xs text-slate-700">
                            <li class="flex items-center gap-2.5"><span class="font-bold text-emerald-600">✓</span> No personal information required</li>
                            <li class="flex items-center gap-2.5"><span class="font-bold text-emerald-600">✓</span> Receive a reference code to track status</li>
                            <li class="flex items-center gap-2.5"><span class="font-bold text-emerald-600">✓</span> Add information and evidence later</li>
                            <li class="flex items-center gap-2.5"><span class="font-bold text-emerald-600">✓</span> No sign-in needed to report</li>
                        </ul>

                        <a asp-controller="AnonymousComplaints" asp-action="Portal" class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V7a5 5 0 0 1 10 0v3m-11.25 0h12.5A1.75 1.75 0 0 1 20 11.75v7.5A1.75 1.75 0 0 1 18.25 21h-12.5A1.75 1.75 0 0 1 4 19.25v-7.5A1.75 1.75 0 0 1 5.75 10Z"/></svg>
                            Continue Anonymously
                        </a>

                        <a asp-controller="AnonymousComplaints" asp-action="Track" class="mt-4 flex items-center justify-center gap-2 border-b border-slate-200 py-3 text-xs font-medium text-slate-600 transition hover:text-blue-700">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7h8m-8 4h8m-8 4h5M5 3.75h14A1.25 1.25 0 0 1 20.25 5v14A1.25 1.25 0 0 1 19 20.25H5A1.25 1.25 0 0 1 3.75 19V5A1.25 1.25 0 0 1 5 3.75Z"/></svg>
                            Already submitted? Track your concern
                        </a>
                        <p class="mt-4 text-center text-xs text-slate-600">Want to submit as a logged-in employee? <a asp-controller="Account" asp-action="Register" class="font-medium text-blue-700 hover:text-indigo-700">Create account</a></p>
                    }
                    else
                    {
                        @if (TempData["PasswordResetSuccess"] is string passwordResetSuccess)
                        {
                            <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">@passwordResetSuccess</div>
                        }

                        <form asp-action="Login" asp-controller="Account" method="post" class="space-y-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                            <div>
                                <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400"><svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6.75h16A1.25 1.25 0 0 1 21.25 8v8A1.25 1.25 0 0 1 20 17.25H4A1.25 1.25 0 0 1 2.75 16V8A1.25 1.25 0 0 1 4 6.75Z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m3.5 7.5 8.5 6 8.5-6"/></svg></span>
                                    <input asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com" class="w-full rounded-xl border border-slate-200 bg-slate-50/70 py-3 pl-10 pr-4 text-sm shadow-sm shadow-slate-900/[0.02] outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10" />
                                </div>
                                <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                            </div>
                            <div>
                                <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                                <div class="relative">
                                    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400"><svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V7a5 5 0 0 1 10 0v3m-11.25 0h12.5A1.75 1.75 0 0 1 20 11.75v7.5A1.75 1.75 0 0 1 18.25 21h-12.5A1.75 1.75 0 0 1 4 19.25v-7.5A1.75 1.75 0 0 1 5.75 10Z"/><path stroke-linecap="round" stroke-width="1.8" d="M12 14v3"/></svg></span>
                                    <input id="loginPassword" asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter your password" class="w-full rounded-xl border border-slate-200 bg-slate-50/70 py-3 pl-10 pr-11 text-sm shadow-sm shadow-slate-900/[0.02] outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10" />
                                    <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400 transition hover:text-blue-700" aria-label="Show password" aria-pressed="false"><svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 12s3.5-6 9.75-6 9.75 6 9.75 6-3.5 6-9.75 6-9.75-6-9.75-6Z"/><circle cx="12" cy="12" r="2.75" stroke-width="1.8"/></svg></button>
                                </div>
                                <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                            </div>

                            <div class="flex items-center justify-between gap-3 pt-1">
                                <label class="flex cursor-pointer items-center gap-2 text-xs text-slate-600"><input asp-for="RememberMe" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" /><span>Remember me</span></label>
                                <a asp-action="ForgotPassword" asp-controller="Account" class="text-xs font-medium text-blue-700 transition hover:text-indigo-700">Forgot password?</a>
                            </div>

                            <button type="submit" class="group w-full rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-indigo-600/25 focus:outline-none focus:ring-4 focus:ring-blue-500/20"><span class="inline-flex items-center justify-center gap-2">Sign in <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-6-6 6 6-6 6"/></svg></span></button>
                        </form>

                        <div class="mt-5 border-t border-slate-200 pt-4 text-center text-sm text-slate-600">Don't have an account? <a asp-action="Register" asp-controller="Account" class="font-medium text-blue-700 transition hover:text-indigo-700">Create account</a></div>
                    }
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        (() => {
            const password = document.getElementById('loginPassword');
            const toggle = document.getElementById('togglePassword');
            if (!password || !toggle) return;
            toggle.addEventListener('click', () => {
                const show = password.type === 'password';
                password.type = show ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', String(show));
                toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                toggle.innerHTML = show
                    ? '<svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.25 0 9.75 7 9.75 7a17.1 17.1 0 0 1-3.1 3.9M6.2 6.2C3.7 8 2.25 12 2.25 12s3.5 7 9.75 7a10.8 10.8 0 0 0 4-.75"/></svg>'
                    : '<svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 12s3.5-6 9.75-6 9.75 6 9.75 6-3.5 6-9.75 6-9.75-6-9.75-6Z"/><circle cx="12" cy="12" r="2.75" stroke-width="1.8"/></svg>';
            });
        })();
    </script>
</body>
</html>
