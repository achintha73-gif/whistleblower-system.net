@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Good morning, @ViewBag.FullName 👋</h1>
            <p class="mt-1 text-sm text-gray-600">Here is an overview of your concerns.</p>
        </div>
        <a asp-controller="Complaints" asp-action="Create"
           class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Submit New Concern
        </a>
    </div>

    <div class="rounded-2xl border border-white/60 bg-white/60 p-6 shadow-lg backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-gray-900">Welcome to your Employee Dashboard</h2>
        <p class="mt-2 text-sm text-gray-600">Submit concerns and track their status from here.</p>
        <div class="mt-4 flex gap-3">
            <a asp-controller="Complaints" asp-action="Index" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">
                View My Concerns
            </a>
        </div>
    </div>
</div>