@model Whistleblowing.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Whistleblowing System</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#f5f7ff] text-slate-900 antialiased">
    <div class="pointer-events-none fixed -right-32 -top-32 h-96 w-96 rounded-full bg-violet-300/30 blur-3xl"></div>
    <main class="relative flex min-h-screen items-center justify-center p-4 sm:p-8">
        <section class="w-full max-w-lg rounded-[2rem] border border-white/80 bg-white/80 p-7 shadow-[0_30px_100px_-35px_rgba(37,55,110,0.3)] backdrop-blur-xl sm:p-10">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white shadow-lg shadow-blue-600/25">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V7a5 5 0 0 1 10 0v3m-11.25 0h12.5A1.75 1.75 0 0 1 20 11.75v7.5A1.75 1.75 0 0 1 18.25 21h-12.5A1.75 1.75 0 0 1 4 19.25v-7.5A1.75 1.75 0 0 1 5.75 10Z"/></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">Secure account recovery</p>
            <h1 class="text-3xl font-semibold tracking-tight">Set a new password</h1>
            <p class="mt-2 text-sm text-slate-500">Choose a new password for your account.</p>
            <form asp-action="ResetPassword" method="post" class="mt-8 space-y-5">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                <div>
                    <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Email" type="email" readonly class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-slate-600 outline-none" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Password" autocomplete="new-password" placeholder="At least 8 characters" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Enter the new password again" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
                </div>
                <button type="submit" class="w-full rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5 hover:from-blue-700 hover:to-indigo-700">Change password</button>
            </form>
        </section>
    </main>
</body>
</html>
