@using Whistleblowing.Application.DTOs
@using Whistleblowing.Domain.Enums
@model IReadOnlyList<UserListItemDto>
@{
    ViewData["Title"] = "Users";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var currentRole = ViewBag.CurrentRole as string;
}

<div class="space-y-6">
    @if (TempData["Success"] != null)
    {
        <div class="flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">@TempData["Error"]</div>
    }

    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg shadow-blue-500/30">
                <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">
                    @(isAdmin ? "User Management" : "Department Team")
                </h1>
                <p class="mt-0.5 text-sm text-gray-600">
                    @(isAdmin ? "All users in the system." : "Users in your department.")
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="inline-flex items-center gap-2 rounded-xl border border-white/60 bg-white/60 px-3.5 py-2 shadow-lg backdrop-blur-xl">
                <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span class="text-sm font-semibold text-gray-900">@Model.Count user@(Model.Count == 1 ? "" : "s")</span>
            </div>
            @if (isAdmin)
            {
                <a asp-action="Create"
                   class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-blue-500/30 transition hover:from-blue-700 hover:to-indigo-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    New User
                </a>
            }
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-hidden rounded-2xl border border-white/60 bg-white/60 shadow-lg backdrop-blur-xl">
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="border-b border-white/60 bg-white/40">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">User</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Role</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Department</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Joined</th>
                        @if (isAdmin) { <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Actions</th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/50">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 6 : 5)" class="px-4 py-12 text-center text-sm text-gray-500">
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var roleClass = user.RoleName switch
                            {
                                "Admin" => "bg-purple-100 text-purple-800 border-purple-200",
                                "Manager" => "bg-blue-100 text-blue-800 border-blue-200",
                                "Investigator" => "bg-amber-100 text-amber-800 border-amber-200",
                                _ => "bg-green-100 text-green-800 border-green-200",
                            };
                            var statusClass = user.Status switch
                            {
                                "Active" => "bg-emerald-100 text-emerald-700 border-emerald-200",
                                "Suspended" => "bg-red-100 text-red-700 border-red-200",
                                _ => "bg-gray-100 text-gray-600 border-gray-200",
                            };
                            <tr class="transition hover:bg-white/60">
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 text-sm font-semibold text-white shadow-md">
                                            @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                        </div>
                                        <div class="min-w-0">
                                            <div class="truncate text-sm font-semibold text-gray-900">@user.FullName</div>
                                            <div class="truncate text-xs text-gray-500">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium @roleClass">
                                        @user.RoleName
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-700">
                                    @(user.DepartmentName ?? "—")
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium @statusClass">
                                        @user.Status
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                @if (isAdmin)
                                {
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex justify-end gap-1"><a asp-action="Edit" asp-route-id="@user.Id" class="rounded-md px-2 py-1 text-xs font-medium text-blue-600 transition hover:bg-blue-50 hover:text-blue-800">Edit</a><form asp-action="Archive" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Archive this user account? They will lose access, but their records will remain.');">@Html.AntiForgeryToken()<button type="submit" class="rounded-md px-2 py-1 text-xs font-medium text-rose-600 transition hover:bg-rose-50 hover:text-rose-800">Archive</button></form></div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
